{
  "name": "@labelbridge/node",
  "version": "0.1.0",
  "description": "ラベルプリンターを Node / Electron のメインプロセスから使う: UDP/TCP 9100（SR5900P）",
  "keywords": [
    "label-printer",
    "electron",
    "dot-by-dot",
    "tcp",
    "udp"
  ],
  "license": "MIT OR Apache-2.0",
  "homepage": "https://github.com/takustaqu/labelbridge/tree/main/packages/node#readme",
  "bugs": {
    "url": "https://github.com/takustaqu/labelbridge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/takustaqu/labelbridge.git",
    "directory": "packages/node"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "types": "./dist/index.d.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@labelbridge/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5",
    "tsup": "8.5.1"
  }
}
