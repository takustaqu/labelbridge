{
  "name": "@takustaqu/labelbridge",
  "version": "0.1.1",
  "description": "Dot-by-dot printing for some KING JIM label printers without vendor drivers. Browser (WebUSB / Web Serial) and Node (LAN).",
  "keywords": [
    "label-printer",
    "webusb",
    "web-serial",
    "dot-by-dot",
    "raster",
    "electron"
  ],
  "license": "MIT OR Apache-2.0",
  "author": "takustaqu",
  "homepage": "https://takustaqu.github.io/labelbridge/",
  "bugs": {
    "url": "https://github.com/takustaqu/labelbridge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/takustaqu/labelbridge.git",
    "directory": "packages/labelbridge"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/core/index.ts",
    "./web": "./src/web/index.ts",
    "./node": "./src/node/index.ts"
  },
  "files": [
    "dist",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "README.md",
    "README.ja.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./web": {
        "types": "./dist/web.d.ts",
        "import": "./dist/web.js"
      },
      "./node": {
        "types": "./dist/node.d.ts",
        "import": "./dist/node.js"
      }
    },
    "types": "./dist/index.d.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && node scripts/add-type-refs.mjs",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@types/w3c-web-serial": "^1.0.8",
    "@types/w3c-web-usb": "^1.0.14"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
