{
  "name": "@labelbridge/web",
  "version": "0.1.0",
  "description": "ラベルプリンターをブラウザから使う: WebUSB（SR3500P）・Web Serial（SR-R2500P）のチャネルと高水準 API",
  "keywords": [
    "label-printer",
    "webusb",
    "web-serial",
    "dot-by-dot"
  ],
  "license": "MIT OR Apache-2.0",
  "homepage": "https://github.com/takustaqu/labelbridge/tree/main/packages/web#readme",
  "bugs": {
    "url": "https://github.com/takustaqu/labelbridge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/takustaqu/labelbridge.git",
    "directory": "packages/web"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@labelbridge/core": "workspace:*",
    "@types/w3c-web-serial": "^1.0.8",
    "@types/w3c-web-usb": "^1.0.14"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "tsup": "8.5.1"
  }
}
