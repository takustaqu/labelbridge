{
  "name": "@labelbridge/core",
  "version": "0.1.0",
  "description": "ラベルプリンター（SR3500P / SR-R2500P / SR5900P）のジョブ生成・ステータス解釈・印刷手順。環境に依存しない",
  "keywords": [
    "label-printer",
    "dot-by-dot",
    "raster",
    "escp"
  ],
  "license": "MIT OR Apache-2.0",
  "homepage": "https://github.com/takustaqu/labelbridge/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/takustaqu/labelbridge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/takustaqu/labelbridge.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5",
    "tsup": "8.5.1"
  }
}
