{
  "id": "/",
  "name": "labelbridge LAN printing",
  "short_name": "labelbridge",
  "version": "0.1.0",
  "description": "Print to LAN label printers dot by dot with Direct Sockets (Isolated Web App sample).",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0f1115",
  "theme_color": "#0f1115",
  "icons": [{ "src": "/icon.png", "type": "image/png", "sizes": "512x512", "purpose": "any" }],
  "isolated_storage": true,
  "permissions_policy": {
    "cross-origin-isolated": ["self"],
    "direct-sockets": ["self"],
    "direct-sockets-private": ["self"],
    "local-network": ["self"]
  }
}
